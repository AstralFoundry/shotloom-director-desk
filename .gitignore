# Source-only repository: opt in to product source and reproducible tooling.
/*
!/.gitignore
!/.editorconfig
!/.prettierrc.json
!/.prettierignore
!/README.md
!/README.en.md
!/LICENSE
!/package.json
!/package-lock.json
!/index.html
!/tsconfig.json
!/vite.config.mjs
!/src/
!/public/
!/tests/
!/docs/
/docs/*
!/docs/images/
!/scripts/
/scripts/*
!/scripts/check-release-privacy.mjs
!/scripts/smoke.mjs
!/scripts/screenshots.mjs
!/scripts/demo-scene.mjs
!/scripts/demo-video.mjs
!/scripts/smoke-depth.mjs
!/scripts/smoke-timeline.mjs
!/scripts/generate-theme-css.mjs
!/scripts/test-assets.mjs
!/scripts/test-asset-sources.json

# Credentials and local artifacts remain excluded inside source directories too.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
ai-channels.json
ai-conversation.json
mcp-connection.json
mcp-connection.json.tmp
file-locations.json
/public/models/*.glb
*.zip
*.exe
